# ===== IEEE SVCE Digital Institution =====
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.

# --- Database ---
# Local Docker: postgresql://ieee:ieee_dev@localhost:5432/ieee_svce
# Production: connection string from Neon/Supabase
DATABASE_URL=postgresql://ieee:ieee_dev@localhost:5432/ieee_svce

# --- Authentication (Auth.js) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-a-real-secret

# Base URL for auth callbacks
AUTH_URL=http://localhost:3000

# --- Application ---
NODE_ENV=development
